datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  name        String
  role        String   @default("COUNCIL") // "ADMIN" or "COUNCIL"
  positionId  String?
  position    Position? @relation(fields: [positionId], references: [id])
  avatar      String?
  createdAt   DateTime @default(now())
  votes       Vote[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Position {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?
  color       String?  @default("blue")
  createdAt   DateTime @default(now())
  users       User[]
}

model DynamicField {
  id           String   @id @default(uuid())
  name         String   // e.g. "تعداد تصویربردار"
  key          String   @unique // e.g. "videographer_count"
  fieldType    String   @default("number") // "number", "text", "select"
  unit         String?  @default("نفر")
  defaultValue String?  @default("1")
  required     Boolean  @default(false)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Project {
  id              String   @id @default(uuid())
  title           String   // نام پروژه
  code            String   @unique // کد پروژه
  description     String?  // شرح پروژه
  productionType  String?  // نوع تولید (تلویزیونی، مستند، ...)
  deadline        String?  // تاریخ جلسه / مهلت رای‌گیری
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_REVISION
  requirements    String   @default("{}") // JSON object of dynamic field key-values
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  votes           Vote[]
  messages        Message[]
}

model Vote {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   // APPROVED, REJECTED, NEEDS_REVISION
  reason    String?  // Required if status == NEEDS_REVISION
  votedAt   DateTime @default(now())

  @@unique([projectId, userId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String?  // Null for group chat
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  isGroup    Boolean  @default(false)
  content    String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
